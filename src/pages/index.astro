---
import { getCollection, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
const posts = Object.values(import.meta.glob("./posts/**/index.{md,mdx}", { eager: true })) as any[];

const snippets = await getCollection("snippets");

const allAssets = import.meta.glob<{ default: ImageMetadata }>("/src/snippets/**/*.{png,jpg,jpeg,gif,webp,svg}", {
  eager: true,
});

function getAssetsForSnippet(snippetId: string) {
  const prefix = `/src/snippets/${snippetId}/`;
  return Object.entries(allAssets)
    .filter(([path]) => path.startsWith(prefix))
    .map(([_, module]) => module.default);
}

const items = await Promise.all(
  snippets.map(async (snippet) => {
    const { Content } = await render(snippet);
    const assets = getAssetsForSnippet(snippet.id);
    console.log(assets);
    return {
      title: snippet.data.title,
      date: snippet.data.date,
      Content,
      assets: assets,
    };
  }),
);

items.sort((a, b) => b.date.getTime() - a.date.getTime());
---

